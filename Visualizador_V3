var viirsProj = viirs.first().projection();

function suavizarViirs(img) {
  return img
    .setDefaultProjection(viirsProj)
    .unmask(0)
    .focal_mean({radius: 2, kernelType: 'gaussian', units: 'pixels', iterations: 2})
    .reproject({crs: viirsProj, scale: 500})
    .updateMask(mascara_uruguay);
}

var years = ee.List.sequence(2017, 2024);
var anuales = ee.ImageCollection(years.map(function(y) {
  return suavizarViirs(viirs.filter(ee.Filter.calendarRange(y, y, 'year')).max()).set('year', y);
