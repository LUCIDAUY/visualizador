function buildSLD(arr) {
  var s = '<RasterSymbolizer><ColorMap type="intervals" extended="false">';
  arr.forEach(function(i){ s += '<ColorMapEntry color="'+i.c+'" quantity="'+i.q+'" opacity="'+(i.a?'1.0':'0.0')+'"/>'; });
  return s + '</ColorMap></RasterSymbolizer>';
}

