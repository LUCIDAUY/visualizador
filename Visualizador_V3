var CAPAS_CON_SENTINEL = ['Análisis: Evolución Histórica'];

function renderLayers() {
  var mode = layerSelect.getValue();
  var tieneSentinel = CAPAS_CON_SENTINEL.indexOf(mode) > -1;

  // ── MODO COMPARACIÓN ──────────────────────────────────────────────
  if (modoComparacion) {
    var yl = parseInt(yearLeftSelect.getValue());
    var yr = parseInt(yearRightSelect.getValue());

    labelLeft.setValue('AÑO ' + yl);
    labelRight.setValue('AÑO ' + yr);

    setBasemap(leftMap,  true);
    setBasemap(rightMap, true);

    // Sentinel-2 base
    setNamedLayer(leftMap,  NOM.S2_LEFT,  ui.Map.Layer(sentinelBase(yl), S2_VIS, NOM.S2_LEFT,  true));
    setNamedLayer(rightMap, NOM.S2_RIGHT, ui.Map.Layer(sentinelBase(yr), S2_VIS, NOM.S2_RIGHT, true));

    // VIIRS analítica
    var viirsL = anuales.filter(ee.Filter.eq('year', yl)).first().updateMask(mascara_uruguay).sldStyle(buildSLD(stateRad));
    var viirsR = anuales.filter(ee.Filter.eq('year', yr)).first().updateMask(mascara_uruguay).sldStyle(buildSLD(stateRad));
    setNamedLayer(leftMap,  NOM.VIIRS_LEFT,  ui.Map.Layer(viirsL, {}, NOM.VIIRS_LEFT));
    setNamedLayer(rightMap, NOM.VIIRS_RIGHT, ui.Map.Layer(viirsR, {}, NOM.VIIRS_RIGHT));

    var op = compareOpacitySlider.getValue();
    var ll = leftMap.layers(), rl = rightMap.layers();
    for (var i = 0; i < ll.length(); i++) { if (ll.get(i).getName() === NOM.VIIRS_LEFT)  { ll.get(i).setOpacity(op); break; } }
    for (var j = 0; j < rl.length(); j++) { if (rl.get(j).getName() === NOM.VIIRS_RIGHT) { rl.get(j).setOpacity(op); break; } }

    // Cuadrícula
    if (gridCheckbox.getValue()) {
      setNamedLayer(leftMap,  NOM.GRID_LEFT,  ui.Map.Layer(cuadricula, {palette:['#ffffff']}, NOM.GRID_LEFT,  true, 0.15));
      setNamedLayer(rightMap, NOM.GRID_RIGHT, ui.Map.Layer(cuadricula, {palette:['#ffffff']}, NOM.GRID_RIGHT, true, 0.15));
    } else {
      removeNamedLayer(leftMap,  NOM.GRID_LEFT);
      removeNamedLayer(rightMap, NOM.GRID_RIGHT);
    }

    return;
  }

  // ── MODO NORMAL ───────────────────────────────────────────────────
  setBasemap(mainMap, tieneSentinel);

  if (tieneSentinel) {
    var year = parseInt(yearSelect.getValue());
    labelMain.setValue('AÑO ' + year);
    labelMain.style().set('shown', true);
    setNamedLayer(mainMap, NOM.S2_MAIN, ui.Map.Layer(sentinelBase(year), S2_VIS, NOM.S2_MAIN, true));
  } else {
    labelMain.style().set('shown', false);
    removeNamedLayer(mainMap, NOM.S2_MAIN);
  }

  // Capa analítica
  var analítica;
  if (mode === 'Análisis: Evolución Histórica') {
    var yr2 = parseInt(yearSelect.getValue());
    analítica = ui.Map.Layer(
      anuales.filter(ee.Filter.eq('year', yr2)).first().updateMask(mascara_uruguay).sldStyle(buildSLD(stateRad)),
      {}, NOM.VIIRS_MAIN
    );
  } else if (mode === 'Análisis: Delta (2017-2024)') {
    analítica = ui.Map.Layer(delta.updateMask(mascara_uruguay).sldStyle(buildSLD(stateDelta)), {}, NOM.VIIRS_MAIN);
  } else if (mode === 'Análisis: Mapa de Anomalías') {
    analítica = ui.Map.Layer(anomalia_img.updateMask(mascara_uruguay).sldStyle(buildSLD(stateAnom)), {}, NOM.VIIRS_MAIN);
  } else if (mode === 'Variable: Huella Edilicia (Bordes)') {
    analítica = ui.Map.Layer(bordes_edificios.updateMask(mascara_uruguay), {palette:['#ff0000']}, NOM.VIIRS_MAIN);
  } else if (mode === 'Variable: Altura Edilicia') {
    analítica = ui.Map.Layer(densidad_edilicia.updateMask(mascara_uruguay).sldStyle(buildSLD(stateAltura)), {}, NOM.VIIRS_MAIN);
  } else if (mode === 'Variable: Rutas Nacionales') {
    analítica = ui.Map.Layer(rutas_raster, {palette:['#ffff00'], min:1, max:1}, NOM.VIIRS_MAIN);
  } else if (mode === 'Variable: Densidad Poblacional') {
    analítica = ui.Map.Layer(poblacion.updateMask(mascara_uruguay).sldStyle(buildSLD(statePop)), {}, NOM.VIIRS_MAIN);
  } else if (mode === 'Variable: Uso del Suelo (MGAP)') {
    analítica = ui.Map.Layer(uso_suelo_visual.updateMask(mascara_uruguay).sldStyle(buildSLD(stateUso)), {}, NOM.VIIRS_MAIN);
  } else if (mode === 'Variable: Áreas Protegidas (SNAP)') {
    analítica = ui.Map.Layer(snap_raster, {palette:['#2ca25f'], min:1, max:1}, NOM.VIIRS_MAIN, true, 0.6);
  }

  setNamedLayer(mainMap, NOM.VIIRS_MAIN, analítica);

  var l = mainMap.layers();
  for (var k = 0; k < l.length(); k++) {
    if (l.get(k).getName() === NOM.VIIRS_MAIN) { l.get(k).setOpacity(mainOpacitySlider.getValue()); break; }
  }

  // Cuadrícula
  if (gridCheckbox.getValue()) {
    setNamedLayer(mainMap, NOM.GRID_MAIN, ui.Map.Layer(cuadricula, {palette:['#ffffff']}, NOM.GRID_MAIN, true, 0.15));
  } else {
    removeNamedLayer(mainMap, NOM.GRID_MAIN);
  }
}

