// Reemplaza una capa existente por nombre, o la agrega si no existe
function setNamedLayer(mapa, nombre, layer) {
  var layers = mapa.layers();
  for (var i = 0; i < layers.length(); i++) {
    if (layers.get(i).getName() === nombre) {
      layers.set(i, layer);
      return;
    }
  }
  layers.add(layer);
}

// Elimina una capa por nombre si existe
function removeNamedLayer(mapa, nombre) {
  var layers = mapa.layers();
  for (var i = 0; i < layers.length(); i++) {
    if (layers.get(i).getName() === nombre) {
      layers.remove(layers.get(i));
      return;
    }
  }
}

