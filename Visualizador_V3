// 10. EVENTOS
// ==========================================
compareCheckbox.onChange(function(checked) {
  modoComparacion = checked;
  var esEvolucion = (layerSelect.getValue() === 'Análisis: Evolución Histórica');

  if (checked) {
    var c = mainMap.getCenter(), z = mainMap.getZoom();
    leftMap.centerObject(c, z);

    compareYearPanel.style().set('shown', true);
    yearLabel.style().set('shown', false);
    yearSelect.style().set('shown', false);
    mainOpacityLabel.style().set('shown', false);
    mainOpacitySlider.style().set('shown', false);

    ui.root.widgets().set(1, splitPanel);
  } else {
    var c2 = leftMap.getCenter(), z2 = leftMap.getZoom();
    mainMap.centerObject(c2, z2);

    compareYearPanel.style().set('shown', false);
    yearLabel.style().set('shown', esEvolucion);
    yearSelect.style().set('shown', esEvolucion);
    mainOpacityLabel.style().set('shown', true);
    mainOpacitySlider.style().set('shown', true);

    // Limpiamos capas dinámicas del comparador al volver al modo normal
    removeNamedLayer(leftMap,  NOM.S2_LEFT);
    removeNamedLayer(rightMap, NOM.S2_RIGHT);
    removeNamedLayer(leftMap,  NOM.VIIRS_LEFT);
    removeNamedLayer(rightMap, NOM.VIIRS_RIGHT);
    removeNamedLayer(leftMap,  NOM.GRID_LEFT);
    removeNamedLayer(rightMap, NOM.GRID_RIGHT);

    ui.root.widgets().set(1, mainMap);
  }

  renderLayers();
});

layerSelect.onChange(function(mode) {
  var esEvolucion = (mode === 'Análisis: Evolución Histórica');

  yearLabel.style().set('shown', esEvolucion && !modoComparacion);
  yearSelect.style().set('shown', esEvolucion && !modoComparacion);
  compareCheckbox.style().set('shown', esEvolucion);

  if (!esEvolucion && modoComparacion) {
    compareCheckbox.setValue(false, true);
    return;
  }

  updateLayerInfo(mode);
  updateLegend(mode);
  renderLayers();
});

yearSelect.onChange(renderLayers);
yearLeftSelect.onChange(renderLayers);
yearRightSelect.onChange(renderLayers);
gridCheckbox.onChange(renderLayers);

