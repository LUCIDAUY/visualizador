var makeToggleRow = function(color, name, isActive, onChange, compact) {
  var pad  = compact ? '6px'  : '8px';
  var wid  = compact ? '20px' : '24px';
  var fSz  = compact ? '11px' : '12px';
  var mBox = compact ? '0 0 2px 0' : '0 0 6px 0';
  var mChk = compact ? '0 0 2px 10px' : '0 0 6px 12px';
  var box  = ui.Label('', {backgroundColor:color, padding:pad, margin:mBox, width:wid, border:'1px solid #333'});
  var chk  = ui.Checkbox({label:name, value:isActive, onChange:onChange, style:{color:colors.text, backgroundColor:colors.surface, margin:mChk, fontSize:fSz}});
  return ui.Panel({widgets:[box,chk], layout:ui.Panel.Layout.Flow('horizontal'), style:{backgroundColor:colors.surface}});
};

function updateLegend(mode) {
  legendContainer.clear();
  var unit = '';
  if (['Análisis: Evolución Histórica','Análisis: Delta (2017-2024)'].indexOf(mode) > -1) unit = ' [nW/cm²*sr]';
  else if (mode === 'Variable: Altura Edilicia')      unit = ' [Metros]';
  else if (mode === 'Variable: Densidad Poblacional') unit = ' [hab/km²]';
  else if (mode === 'Análisis: Mapa de Anomalías')    unit = ' [Índice]';

  legendContainer.add(ui.Label('LEYENDA DE DATOS' + unit, {fontWeight:'bold', fontSize:'11px', color:colors.accent, backgroundColor:colors.surface, margin:'0 0 10px 0'}));

  var ri = function(arr, compact) {
    arr.forEach(function(item) {
      legendContainer.add(makeToggleRow(item.c, item.l, item.a, function(v){ item.a = v; renderLayers(); }, compact));
    });
  };

  if      (mode === 'Análisis: Evolución Histórica')        ri(stateRad, true);
  else if (mode === 'Análisis: Mapa de Anomalías')           ri(stateAnom, false);
  else if (mode === 'Análisis: Delta (2017-2024)')           ri(stateDelta, false);
  else if (mode === 'Variable: Huella Edilicia (Bordes)')    ri(stateHuella, false);
  else if (mode === 'Variable: Altura Edilicia')             ri(stateAltura, false);
  else if (mode === 'Variable: Rutas Nacionales')            ri(stateRutas, false);
  else if (mode === 'Variable: Densidad Poblacional')        ri(statePop, false);
  else if (mode === 'Variable: Uso del Suelo (MGAP)')        ri(stateUso, true);
  else if (mode === 'Variable: Áreas Protegidas (SNAP)')     ri(stateSnap, false);
}

