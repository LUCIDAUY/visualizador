var landClasses = {
  1:'Zona Urbanizada',2:'Canteras / Minas',3:'Playas y Dunas',4:'Aguas artificiales',
  5:'Represas de riego',6:'Aguas naturales',7:'Bañados y Humedales',8:'Bosque Nativo',
  9:'Bosque Plantado',10:'Bosque Plantado (tala)',11:'Citrus',12:'Olivares',
  13:'Agricultura',14:'Rastrojos de invierno',15:'Cultivo de Arroz',16:'Rastrojos de Arroz',
  17:'Caña de Azucar',18:'Pivotes',19:'Rastrojos de Pasturas',20:'Zona Hortifrutivícola',
  21:'Mezcla',22:'Campo Nat. y Horticultura',23:'Campo Natural',24:'Campo Nat. regenerado',
  25:'Campo Nat. y Palmares',26:'Otros frutales',27:'Arbustos'
};

function ejecutarAuditoria(lon, lat, centrarMapa) {
  infoInstruccion.setValue('Extrayendo datos...');
  infoInstruccion.style().set('color', colors.accent);
  resultsPanel.style().set('shown', false);

  if (centrarMapa) { mainMap.setCenter(lon, lat, 15); leftMap.setCenter(lon, lat, 15); }

  currentSelectedPoint = ee.Geometry.Point(lon, lat);
  var boxOutline = ee.Image().byte().paint({
    featureCollection: ee.FeatureCollection(currentSelectedPoint.buffer(250).bounds()),
    color:1, width:3
  });

  setNamedLayer(mainMap, NOM.PIXEL_MAIN, ui.Map.Layer(boxOutline, {palette:[colors.highlight]}, NOM.PIXEL_MAIN));
  setNamedLayer(leftMap, NOM.PIXEL_LEFT, ui.Map.Layer(boxOutline, {palette:[colors.highlight]}, NOM.PIXEL_LEFT));

  rowCoords.val.setValue(lat.toFixed(4) + ', ' + lon.toFixed(4));
  rowCoords.panel.style().set('shown', true);

  var mode = layerSelect.getValue();
  var year = parseInt(yearSelect.getValue());
  var yl   = parseInt(yearLeftSelect.getValue());
  var yr   = parseInt(yearRightSelect.getValue());

  var imgConsulta = modoComparacion
    ? anuales.filter(ee.Filter.eq('year', yl)).first()
    : (mode === 'Análisis: Evolución Histórica' ? anuales.filter(ee.Filter.eq('year', year)).first() : L2024);

  rowRad.lbl.setValue(modoComparacion ? 'Radiancia (' + yl + '):' :
    (mode === 'Análisis: Evolución Histórica' ? 'Radiancia (' + year + '):' : 'Radiancia (2024):'));

  var getSnapName = ee.Algorithms.If(
    snap.filterBounds(currentSelectedPoint).size().gt(0),
    snap.filterBounds(currentSelectedPoint).first().get('nombre'),
    -9999
  );

  ee.Dictionary({
    rad:        imgConsulta.unmask(-9999).reduceRegion(ee.Reducer.mean(), currentSelectedPoint, 500).get('avg_rad'),
    radRight:   anuales.filter(ee.Filter.eq('year', yr)).first().unmask(-9999).reduceRegion(ee.Reducer.mean(), currentSelectedPoint, 500).get('avg_rad'),
    delta:      delta.unmask(-9999).reduceRegion(ee.Reducer.mean(), currentSelectedPoint, 500).get('delta_L'),
    anom:       anomalia_img.unmask(-9999).reduceRegion(ee.Reducer.mean(), currentSelectedPoint, 500).get('anomalia'),
    buildFP:    huella_edilicia.unmask(-9999).reduceRegion(ee.Reducer.mean(), currentSelectedPoint, 20).get('huella'),
    buildH:     densidad_edilicia.unmask(-9999).reduceRegion(ee.Reducer.mean(), currentSelectedPoint, 20).get('altura_media'),
    pop:        poblacion.unmask(-9999).reduceRegion(ee.Reducer.mean(), currentSelectedPoint, 100).get('poblacion'),
    land:       uso_suelo.unmask(-9999).reduceRegion(ee.Reducer.first(), currentSelectedPoint, 10).get('b1'),
    roadDist:   distancia_rutas.unmask(-9999).reduceRegion(ee.Reducer.first(), currentSelectedPoint, 10).get('distance'),
    snapNombre: getSnapName
  }).evaluate(function(res, err) {
    if (err || !res) { infoInstruccion.setValue('Error en lectura.'); return; }

    var ok  = function(v) { return v !== null && v !== undefined && v !== -9999; };
    var cnt = 0;
    var row = function(obj, cond, txt) {
      if (cond) { obj.val.setValue(txt); obj.panel.style().set('shown', true); cnt++; }
      else      { obj.panel.style().set('shown', false); }
    };

    row(rowRad, ok(res.rad), ok(res.rad) ? res.rad.toFixed(2) + ' nW/cm²*sr' : '');

    if (modoComparacion && ok(res.radRight)) {
      rowRadRight.lbl.setValue('Radiancia (' + yr + '):');
      var diff = res.radRight - res.rad, signo = diff >= 0 ? '+' : '';
      rowRadRight.val.setValue(res.radRight.toFixed(2) + ' nW/cm²*sr  (' + signo + diff.toFixed(2) + ')');
      rowRadRight.panel.style().set('shown', true);
    } else { rowRadRight.panel.style().set('shown', false); }

    row(rowDelta,   ok(res.delta),   ok(res.delta)   ? res.delta.toFixed(2)   + ' nW/cm²*sr' : '');
    row(rowAnom,    ok(res.anom),    ok(res.anom)    ? res.anom.toFixed(2)    : '');
    row(rowBuildFP, ok(res.buildFP), ok(res.buildFP) ? res.buildFP.toFixed(1) + ' %' : '');
    row(rowBuildH,  ok(res.buildH),  ok(res.buildH)  ? res.buildH.toFixed(1)  + ' m' : '');
    row(rowPop,     ok(res.pop),     ok(res.pop)     ? res.pop.toFixed(0)     + ' hab/km²' : '');
    row(rowSnap,    (res.snapNombre !== -9999 && res.snapNombre !== null), res.snapNombre || '');
    row(rowLand,    ok(res.land),    ok(res.land) ? (landClasses[res.land] || 'Cód. ' + res.land) : '');

    if (cnt > 0) {
      rowRoad.val.setValue(ok(res.roadDist)
        ? (res.roadDist > 1000 ? (res.roadDist/1000).toFixed(1)+' km' : res.roadDist.toFixed(0)+' m')
        : '> 20 km');
      rowRoad.panel.style().set('shown', true);
      infoInstruccion.setValue('Datos cargados.');
      infoInstruccion.style().set('color', colors.textMuted);
      resultsPanel.style().set('shown', true);
    } else {
      infoInstruccion.setValue('No hay datos aquí.');
      resultsPanel.style().set('shown', false);
    }
  });
}

mainMap.onClick(function(c) { ejecutarAuditoria(c.lon, c.lat, false); });
leftMap.onClick(function(c) { ejecutarAuditoria(c.lon, c.lat, false); });

function procesarBusqueda() {
  var txt = searchInput.getValue();
  if (!txt) return;
  var p = txt.replace(/[^\d.-]/g,' ').trim().split(/\s+/);
  if (p.length >= 2) {
    var lat = parseFloat(p[0]), lon = parseFloat(p[1]);
    if (!isNaN(lat) && !isNaN(lon)) ejecutarAuditoria(lon, lat, true);
    else infoInstruccion.setValue('⚠️ Coordenadas inválidas. Usa: Lat, Lon');
  } else { infoInstruccion.setValue('⚠️ Formato incorrecto. Usa: -34.88, -56.16'); }
}
searchBtn.onClick(procesarBusqueda);
searchInput.onChange(procesarBusqueda);

